---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
}

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { url } from "../../utils/url-utils";

const { id, src: configuredSrc, alt, position = "center", basePath = "/" } = Astro.props;
const src = configuredSrc.trim();
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
let img: ImageMetadata | undefined;
if (isLocal && src) {
	const files = import.meta.glob<ImageMetadata>("../../**/*.{jpeg,jpg,png,tiff,webp,gif,svg,avif,JPEG,JPG,PNG,TIFF,WEBP,GIF,SVG,AVIF}", {
		import: "default",
	});
	const normalizedPath = path.posix.join("../../", basePath.replace(/\\/g, "/"), src.replace(/\\/g, "/"));
	let file = files[normalizedPath];
	// Typora may encode spaces and Chinese characters in image paths.
	if (!file) {
		try {
			file = files[decodeURIComponent(normalizedPath)];
		} catch {
			// A literal percent sign in a filename is not necessarily URL encoding.
		}
	}
	if (file) {
		img = await file();
	} else {
		console.warn(
			`[图片未显示] 找不到 ${normalizedPath.replace(/^\.\.\/\.\.\//, "src/")}。请检查 image 中的文件路径；封面只填写路径，不要填写 ![]() 或电脑绝对路径。`,
		);
	}
}

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {isLocal && img && <Image src={img} alt={alt || ""} class={imageClass} style={imageStyle}/>}
    {!isLocal && <img src={isPublic ? url(src) : src} alt={alt || ""} class={imageClass} style={imageStyle}/>}
</div>
